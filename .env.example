# Exemple de noms de variables pour la configuration Web Firebase.
# Cloudflare Pages : Settings > Variables and Secrets > Production (variables disponibles au BUILD).
# Puis relancer un nouveau déploiement. VITE_* est incorporé au bundle public au build.
# Ne mettez jamais de clé Admin / compte de service ici.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
